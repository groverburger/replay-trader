# Generates OUT (C++) holding every file under ROOT matching *.lua, plus EXTRA files as "README.md" etc.
# Usage: cmake -DROOT=<dir> -DOUT=<file.cpp> [-DEXTRA="name=path;..."] -P embed_files.cmake
file(GLOB_RECURSE files RELATIVE "${ROOT}" "${ROOT}/*.lua")
list(SORT files)
set(entries "")
foreach(f IN LISTS files)
  list(APPEND entries "${f}=${ROOT}/${f}")
endforeach()
foreach(e IN LISTS EXTRA)
  list(APPEND entries "${e}")
endforeach()
set(data "")
set(table "")
set(i 0)
foreach(e IN LISTS entries)
  string(FIND "${e}" "=" eq)
  string(SUBSTRING "${e}" 0 ${eq} name)
  math(EXPR start "${eq} + 1")
  string(SUBSTRING "${e}" ${start} -1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR size "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND data "static const unsigned char d${i}[] = {${bytes}0};\n")
  string(APPEND table "    {\"${name}\", reinterpret_cast<const char*>(d${i}), ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_files.cmake from scripts/ and docs/SCRIPTING.md. Do not edit.\n#include \"embedded_files.h\"\n\n${data}\nconst EmbeddedFile kEmbeddedFiles[] = {\n${table}};\nconst int kEmbeddedFileCount = ${i};\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)

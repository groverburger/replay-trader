@@ -3361,12 +3361,28 @@ int BK_scroll(BKContext *ctx, int x, int y, float dx, float dy, int mods)
     ctx->in_input--;
     return 1;
   }
-  int r = 0;
-  if (dy != 0.0f) {
-    r |= BK_wheel(ctx, x, y, dy > 0.0f ? 1 : -1, mods);
+  /* replay-trader patch: precise vertical deltas scroll the nearest scroll region that can still move, by
+   * exact pixels (a notch is 2 widget units, as scroll_wheel); everything else gets whole notches once enough
+   * has accumulated */
+  if (dy != 0.0f && !(mods & BK_CTRL) && !ctx->modal) {
+    for (BKNode *n = t; n; n = n->parent) {
+      if (n->cls == &bk_cls_scroll && NODE_ENABLED(n) && bk_scroll_by_px(n, dy * 2.0f * (float)BK_unit())) {
+        return 1;
+      }
+    }
   }
-  if (dx != 0.0f) { /* X11's buttons 6 / 7: Shift + wheel, left = up */
-    r |= BK_wheel(ctx, x, y, dx > 0.0f ? -1 : 1, mods | BK_SHIFT);
+  static float acc_x = 0.0f, acc_y = 0.0f;
+  acc_x += dx, acc_y += dy;
+  int r = 0;
+  while (fabsf(acc_y) >= 1.0f) {
+    const int d = acc_y > 0.0f ? 1 : -1;
+    acc_y -= (float)d;
+    r |= BK_wheel(ctx, x, y, d, mods);
+  }
+  while (fabsf(acc_x) >= 1.0f) { /* X11's buttons 6 / 7: Shift + wheel, left = up */
+    const int d = acc_x > 0.0f ? 1 : -1;
+    acc_x -= (float)d;
+    r |= BK_wheel(ctx, x, y, -d, mods | BK_SHIFT);
   }
   return r;
 }

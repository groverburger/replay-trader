+/* replay-trader patch: scrolling moves only this region. Its children are re-arranged in place (sizes don't
+ * change), the pixels already drawn are shifted, and only the newly exposed strip and the scrollbar are
+ * drawn. Upstream relayouts and redraws the whole window for every pixel scrolled. Falls back to redrawing
+ * just this region when shifting isn't safe (pending redraws inside it, popups, no frame drawn yet). */
+static int scroll_shift(BKNode *n, int dy)
+{
+  BKContext *ctx = bk_ctx(n);
+  if (!ctx || ctx->layout_dirty) {
+    return 0; /* a full layout is coming anyway */
+  }
+  scroll_arrange(n);
+  BuiRaster *r = ctx->raster;
+  const int W = r ? BUI_raster_width(r) : 0, H = r ? BUI_raster_height(r) : 0;
+  const int cw = n->w - scroll_bar_w();
+  const int x0 = BK_MAX(n->x, 0), x1 = BK_MIN(n->x + cw, W);
+  const int y0 = BK_MAX(n->y, 0), y1 = BK_MIN(n->y + n->h, H);
+  const BKRect area = bk_rect(x0, y0, x1 - x0, y1 - y0);
+  bool ok = r && !ctx->full_dirty && W == ctx->win_w && H == ctx->win_h && x1 > x0 && y1 > y0 &&
+            abs(dy) < y1 - y0 && BK_popup_count(ctx) == 0;
+  for (int i = 0; ok && i < ctx->ndirty; i++) {
+    const BKRect *d = &ctx->dirty[i];
+    ok = !(d->xmin < area.xmax && area.xmin < d->xmax && d->ymin < area.ymax && area.ymin < d->ymax);
+  }
+  if (!ok) {
+    bk_invalidate(n);
+    return 1;
+  }
+  uint32_t *px = (uint32_t *)BUI_raster_pixels(r);
+  const size_t row = (size_t)(x1 - x0) * sizeof(uint32_t);
+  if (dy > 0) {
+    for (int y = y1 - 1; y >= y0 + dy; y--) {
+      memmove(px + (size_t)y * W + x0, px + (size_t)(y - dy) * W + x0, row);
+    }
+    bk_ctx_dirty_rect(ctx, bk_rect(x0, y0, x1 - x0, dy));
+  }
+  else {
+    for (int y = y0; y < y1 + dy; y++) {
+      memmove(px + (size_t)y * W + x0, px + (size_t)(y - dy) * W + x0, row);
+    }
+    bk_ctx_dirty_rect(ctx, bk_rect(x0, y1 + dy, x1 - x0, -dy));
+  }
+  bk_ctx_dirty_rect(ctx, bk_rect(n->x + cw, y0, n->w - cw, y1 - y0)); /* the scrollbar */
+  if (ctx->has_blit) {
+    ctx->blit.xmin = BK_MIN(ctx->blit.xmin, area.xmin), ctx->blit.ymin = BK_MIN(ctx->blit.ymin, area.ymin);
+    ctx->blit.xmax = BK_MAX(ctx->blit.xmax, area.xmax), ctx->blit.ymax = BK_MAX(ctx->blit.ymax, area.ymax);
+  }
+  else {
+    ctx->blit = area, ctx->has_blit = true;
+  }
+  bk_ctx_request(ctx);
+  return 1;
+}

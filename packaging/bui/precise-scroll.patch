+/* replay-trader patch: scroll by a precise pixel delta (> 0: content moves down, as a wheel turned away);
+ * the sub-pixel remainder is kept per region. Returns 1 when the region moved. */
+int bk_scroll_by_px(BKNode *n, float px)
+{
+  static BKNode *last = NULL;
+  static float rest = 0.0f;
+  if (n != last) {
+    last = n, rest = 0.0f;
+  }
+  rest += px;
+  const int step = (int)rest;
+  if (step == 0) {
+    return scroll_max(n) > 0 && ((px > 0.0f && n->scroll > 0) || (px < 0.0f && n->scroll < scroll_max(n)));
+  }
+  rest -= (float)step;
+  const int old = n->scroll;
+  scroll_set(n, n->scroll - step);
+  if (n->scroll == old) {
+    rest = 0.0f;
+  }
+  return n->scroll != old;
+}

# Applies PATCH to the BUI checkout in the working directory once (FetchContent runs this on every populate).
execute_process(COMMAND git apply --ignore-whitespace --check "${PATCH}" RESULT_VARIABLE can_apply OUTPUT_QUIET ERROR_QUIET)
if(can_apply EQUAL 0)
  execute_process(COMMAND git apply --ignore-whitespace --whitespace=nowarn "${PATCH}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "could not apply ${PATCH}")
  endif()
  message(STATUS "BUI: applied ${PATCH}")
else()
  execute_process(COMMAND git apply --ignore-whitespace --reverse --check "${PATCH}" RESULT_VARIABLE applied OUTPUT_QUIET ERROR_QUIET)
  if(NOT applied EQUAL 0)
    message(FATAL_ERROR "${PATCH} neither applies nor is already applied (BUI version changed?)")
  endif()
endif()
